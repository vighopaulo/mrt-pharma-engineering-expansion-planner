#usda 1.0
(
    defaultPrim = "RepresentativeScanner"
)

def Xform "RepresentativeScanner" (
    customData = {
        string asset_label = "TEST_REPRESENTATIVE_ONLY_NOT_MANUFACTURER_GEOMETRY"
        string visual_asset_authority = "NON_AUTHORITATIVE"
        string visual_asset_geometry_quality = "REPRESENTATIVE_ASSET"
        string visual_asset_purpose = "DEMONSTRATION"
    }
)
{
    def Cylinder "Gantry"
    {
        uniform token axis = "X"
        double height = 0.6
        double radius = 0.9
    }

    def Cube "Table"
    {
        double size = 1
        float3 xformOp:scale = (2.2, 0.5, 0.15)
        double3 xformOp:translate = (1.4, 0, -0.2)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "Base"
    {
        double size = 1
        float3 xformOp:scale = (1, 1, 0.4)
        double3 xformOp:translate = (0, 0, -0.7)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

