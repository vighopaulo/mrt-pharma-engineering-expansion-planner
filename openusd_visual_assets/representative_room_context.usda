#usda 1.0
(
    defaultPrim = "RepresentativeRoomContext"
)

def Xform "RepresentativeRoomContext" (
    customData = {
        string asset_label = "REPRESENTATIVE_ARCHITECTURAL_CONTEXT_NOT_CALIBRATED_ROOM_GEOMETRY"
        string visual_asset_authority = "NON_AUTHORITATIVE"
        string visual_asset_geometry_quality = "REPRESENTATIVE_ASSET"
        string visual_asset_purpose = "DEMONSTRATION"
    }
)
{
    def Cube "Floor"
    {
        double size = 1
        float3 xformOp:scale = (1, 1, 0.05)
        uniform token[] xformOpOrder = ["xformOp:scale"]
    }

    def Cube "WallNorth"
    {
        double size = 1
        float3 xformOp:scale = (1, 0.05, 1)
        double3 xformOp:translate = (0, 0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallSouth"
    {
        double size = 1
        float3 xformOp:scale = (1, 0.05, 1)
        double3 xformOp:translate = (0, -0.5, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }

    def Cube "WallEast"
    {
        double size = 1
        float3 xformOp:scale = (0.05, 1, 1)
        double3 xformOp:translate = (0.5, 0, 0.5)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

