#usda 1.0
(
    defaultPrim = "RepresentativeCyclotron"
)

def Xform "RepresentativeCyclotron" (
    customData = {
        string asset_label = "TEST_REPRESENTATIVE_ONLY_NOT_MANUFACTURER_GEOMETRY"
        string visual_asset_authority = "NON_AUTHORITATIVE"
        string visual_asset_geometry_quality = "REPRESENTATIVE_ASSET"
        string visual_asset_purpose = "DEMONSTRATION"
    }
)
{
    def Cylinder "Body"
    {
        uniform token axis = "Z"
        double height = 1
        double radius = 0.85
    }

    def Cylinder "Shielding"
    {
        uniform token axis = "Z"
        double height = 1.1
        uniform token purpose = "proxy"
        double radius = 1.05
    }

    def Cube "ServiceCabinet"
    {
        double size = 1
        float3 xformOp:scale = (0.5, 0.4, 0.9)
        double3 xformOp:translate = (1.3, 0, -0.05)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
    }
}

