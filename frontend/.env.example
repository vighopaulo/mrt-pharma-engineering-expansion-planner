# Basic Bentley 3D Viewer — browser-safe public configuration ONLY.
# These VITE_ values are compiled into the browser bundle, so they must be
# PUBLIC identifiers only. NEVER put the Bentley Service client SECRET, an
# access token, or the contents of .env.bentley here.

VITE_API_BASE_URL=http://localhost:8000

# MRTway Development Viewer — SPA (Authorization Code + PKCE, NO client secret)
VITE_BENTLEY_SPA_CLIENT_ID=
# Bentley identity authority + scope (defaults shown; usually leave as-is)
VITE_BENTLEY_AUTHORITY=https://ims.bentley.com
VITE_BENTLEY_SCOPE=itwin-platform
# Must match a redirect URI registered on the MRTway Development Viewer SPA
VITE_BENTLEY_REDIRECT_URI=http://localhost:3000/signin-callback
VITE_BENTLEY_POST_SIGNOUT_REDIRECT_URI=http://localhost:3000

# Known live iTwin "MRTway Development Twin" (public id; safe in browser)
VITE_BENTLEY_ITWIN_ID=bdf29ecd-b4a4-404d-861a-ac3061c7b12f
# iModel "MRTway Hospital Campus Development" — fill with its discovered id
VITE_BENTLEY_IMODEL_ID=
